{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansldes.dev/schema/copy-evidence.v1.json",
  "title": "AnslDes locale-aware copy evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceKind",
    "platform",
    "profileId",
    "surfaceId",
    "locale",
    "contentRegistryStatus",
    "nodes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "evidenceKind": {
      "enum": ["web-source", "native-source", "design-document-source"]
    },
    "platform": { "enum": ["web", "react-native", "design-document"] },
    "profileId": { "$ref": "#/$defs/name" },
    "surfaceId": { "$ref": "#/$defs/name" },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
    },
    "contentRegistryStatus": { "enum": ["executed", "not-run"] },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "containerId",
        "contentRole",
        "intent",
        "text",
        "cadencePattern"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "owner": { "$ref": "#/$defs/name" },
        "containerId": { "$ref": "#/$defs/name" },
        "contentRole": {
          "enum": [
            "heading",
            "body",
            "label",
            "question",
            "reason",
            "risk",
            "result",
            "next-action",
            "metric",
            "testimonial",
            "logo-claim",
            "recovery",
            "legal",
            "domain-term"
          ]
        },
        "intent": {
          "enum": ["inform", "instruct", "recover", "market", "claim"]
        },
        "text": { "type": "string", "minLength": 1 },
        "cadencePattern": {
          "enum": ["none", "manufactured-contrast", "short-rebuttal"]
        },
        "featureReference": { "$ref": "#/$defs/name" },
        "rationaleReference": { "$ref": "#/$defs/name" },
        "sourceReference": { "$ref": "#/$defs/name" },
        "recoveryCopyId": { "$ref": "#/$defs/name" }
      }
    }
  }
}
