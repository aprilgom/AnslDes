{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansldes.dev/schema/consumer-conformance.v1.json",
  "title": "AnslDes consumer conformance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "platform",
    "surfaceId",
    "controls"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "profileId": { "$ref": "#/$defs/name" },
    "platform": {
      "enum": ["web", "react-native", "ios", "android", "design-document"]
    },
    "surfaceId": { "$ref": "#/$defs/name" },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/control" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actionId",
        "role",
        "component",
        "label",
        "shapeToken",
        "feedback",
        "states",
        "contractStatus",
        "affordanceSource",
        "motionPurpose",
        "motionRecipeStatus",
        "reduceMotionFallback",
        "prominence",
        "nativePrimitive"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "actionId": { "$ref": "#/$defs/name" },
        "role": {
          "enum": [
            "primary-action",
            "secondary-action",
            "input",
            "selection",
            "navigation",
            "feedback",
            "overlay"
          ]
        },
        "component": { "$ref": "#/$defs/name" },
        "label": { "type": "string", "minLength": 1 },
        "shapeToken": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/$defs/name" },
        "feedback": { "$ref": "#/$defs/name" },
        "states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "default",
              "pressed",
              "focused",
              "disabled",
              "loading",
              "error",
              "selected"
            ]
          }
        },
        "contractStatus": { "enum": ["matched", "mismatched"] },
        "affordanceSource": {
          "enum": [
            "design-system",
            "platform",
            "consumer-exception",
            "invented"
          ]
        },
        "motionPurpose": {
          "enum": ["none", "state-transition", "continuity", "decorative"]
        },
        "motionRecipeStatus": { "enum": ["none", "approved", "unapproved"] },
        "reduceMotionFallback": { "type": "boolean" },
        "rawDurationMs": { "type": "number", "minimum": 0 },
        "prominence": { "enum": ["standard", "emphasized", "oversized"] },
        "nativePrimitive": { "type": "boolean" },
        "exceptionId": { "$ref": "#/$defs/name" }
      }
    }
  }
}
