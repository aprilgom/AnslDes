{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansldes.dev/schema/design-system-definition.v2.json",
  "title": "AnslDes product design-system definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "themes",
    "foundations",
    "components"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "id": { "$ref": "#/$defs/name" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "themes": { "$ref": "#/$defs/themes" },
    "colorUsage": { "$ref": "#/$defs/colorUsage" },
    "foundations": { "$ref": "#/$defs/foundations" },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/componentDefinition" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "reference": {
      "type": "string",
      "pattern": "^\\{(?:color|spacing|radius|size|typography|motion|elevation|layer)\\.[a-z0-9][a-z0-9._-]*\\}$"
    },
    "themes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "default"],
      "properties": {
        "names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        },
        "default": { "$ref": "#/$defs/name" }
      }
    },
    "colorUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contrast", "approvedPalettes"],
      "properties": {
        "contrast": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body", "large"],
          "properties": {
            "body": { "type": "number", "minimum": 4.5, "maximum": 21 },
            "large": { "type": "number", "minimum": 3, "maximum": 21 }
          }
        },
        "approvedPalettes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/approvedPalette" }
        }
      }
    },
    "approvedPalette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contexts", "themes"],
      "properties": {
        "contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["page", "component", "hero", "brand", "status"] }
        },
        "themes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        }
      }
    },
    "foundations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "spacing",
        "radius",
        "size",
        "typography",
        "motion",
        "elevation",
        "layer"
      ],
      "properties": {
        "color": { "$ref": "#/$defs/colorTokens" },
        "spacing": { "$ref": "#/$defs/spacingTokens" },
        "radius": { "$ref": "#/$defs/radiusTokens" },
        "size": { "$ref": "#/$defs/sizeTokens" },
        "typography": { "$ref": "#/$defs/typographyTokens" },
        "motion": { "$ref": "#/$defs/motionTokens" },
        "elevation": { "$ref": "#/$defs/recipeTokens" },
        "layer": { "$ref": "#/$defs/integerTokens" },
        "icon": { "$ref": "#/$defs/iconTokens" }
      }
    },
    "colorTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive", "semantic", "component", "asset"],
      "properties": {
        "primitive": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
          }
        },
        "semantic": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/colorPrimitiveReference"
            }
          }
        },
        "component": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/colorSemanticReference"
          }
        },
        "asset": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
          }
        }
      }
    },
    "radiusTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive", "semantic", "component"],
      "properties": {
        "primitive": { "$ref": "#/$defs/nonNegativeNumberMap" },
        "semantic": { "$ref": "#/$defs/radiusPrimitiveReferenceMap" },
        "component": { "$ref": "#/$defs/radiusSemanticReferenceMap" }
      }
    },
    "sizeTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive", "semantic", "component"],
      "properties": {
        "primitive": { "$ref": "#/$defs/nonNegativeNumberMap" },
        "semantic": { "$ref": "#/$defs/sizePrimitiveReferenceMap" },
        "component": { "$ref": "#/$defs/sizeSemanticReferenceMap" }
      }
    },
    "spacingTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive", "semantic", "component"],
      "properties": {
        "primitive": { "$ref": "#/$defs/signedNumberMap" },
        "semantic": { "$ref": "#/$defs/spacingPrimitiveReferenceMap" },
        "component": { "$ref": "#/$defs/spacingSemanticReferenceMap" }
      }
    },
    "integerTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic", "component"],
      "properties": {
        "semantic": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer" }
        },
        "component": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      }
    },
    "nonNegativeNumberMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "signedNumberMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number" }
    },
    "colorPrimitiveReference": {
      "type": "string",
      "pattern": "^\\{color\\.primitive\\.[a-z0-9][a-z0-9._-]*\\}$"
    },
    "colorSemanticReference": {
      "type": "string",
      "pattern": "^\\{color\\.semantic\\.[a-z0-9][a-z0-9._-]*\\}$"
    },
    "spacingPrimitiveReferenceMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/spacingPrimitiveReference" }
    },
    "spacingSemanticReferenceMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/spacingSemanticReference" }
    },
    "spacingPrimitiveReference": {
      "type": "string",
      "pattern": "^\\{spacing\\.primitive\\.[a-z0-9][a-z0-9._-]*\\}$"
    },
    "spacingSemanticReference": {
      "type": "string",
      "pattern": "^\\{spacing\\.semantic\\.[a-z0-9][a-z0-9._-]*\\}$"
    },
    "radiusPrimitiveReferenceMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/radiusPrimitiveReference" }
    },
    "radiusSemanticReferenceMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/radiusSemanticReference" }
    },
    "radiusPrimitiveReference": {
      "type": "string",
      "pattern": "^\\{radius\\.primitive\\.[a-z0-9][a-z0-9._-]*\\}$"
    },
    "radiusSemanticReference": {
      "type": "string",
      "pattern": "^\\{radius\\.semantic\\.[a-z0-9][a-z0-9._-]*\\}$"
    },
    "sizePrimitiveReferenceMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/sizePrimitiveReference" }
    },
    "sizeSemanticReferenceMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/sizeSemanticReference" }
    },
    "sizePrimitiveReference": {
      "type": "string",
      "pattern": "^\\{size\\.primitive\\.[a-z0-9][a-z0-9._-]*\\}$"
    },
    "sizeSemanticReference": {
      "type": "string",
      "pattern": "^\\{size\\.semantic\\.[a-z0-9][a-z0-9._-]*\\}$"
    },
    "typographyTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familyName", "weights", "tokens", "roles"],
      "properties": {
        "familyName": { "type": "string", "minLength": 1 },
        "weights": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fontFamily", "fontWeight"],
            "properties": {
              "fontFamily": { "type": "string", "minLength": 1 },
              "fontWeight": { "type": "integer", "minimum": 1, "maximum": 1000 }
            }
          }
        },
        "tokens": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fontSize",
              "lineHeight",
              "maxFontSizeMultiplier",
              "allowedWeights"
            ],
            "properties": {
              "fontSize": { "type": "number", "exclusiveMinimum": 0 },
              "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
              "maxFontSizeMultiplier": { "type": "number", "minimum": 1 },
              "allowedWeights": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/name" }
              },
              "category": { "$ref": "#/$defs/name" },
              "functionalTextAllowed": { "type": "boolean" }
            }
          }
        },
        "roles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["visualToken", "weight"],
            "properties": {
              "visualToken": { "$ref": "#/$defs/name" },
              "weight": { "$ref": "#/$defs/name" }
            }
          }
        }
      }
    },
    "motionTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durations", "easings", "transitions"],
      "properties": {
        "durations": { "$ref": "#/$defs/nonNegativeNumberMap" },
        "easings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          }
        },
        "transitions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/motionTransition" }
        }
      }
    },
    "motionTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration", "easing", "reducedMotion"],
      "properties": {
        "owner": { "$ref": "#/$defs/name" },
        "purpose": {
          "enum": [
            "state-change",
            "feedback",
            "loading",
            "reveal",
            "decorative"
          ]
        },
        "duration": { "$ref": "#/$defs/reference" },
        "easing": { "$ref": "#/$defs/reference" },
        "reducedMotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration", "fallback"],
          "properties": {
            "duration": { "$ref": "#/$defs/reference" },
            "fallback": { "$ref": "#/$defs/name" }
          }
        }
      }
    },
    "iconTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sizes",
        "strokes",
        "opticalAlignments",
        "icons",
        "usages",
        "actions"
      ],
      "properties": {
        "sizes": { "$ref": "#/$defs/nonNegativeNumberMap" },
        "strokes": { "$ref": "#/$defs/nonNegativeNumberMap" },
        "opticalAlignments": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        },
        "icons": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/iconDefinition" }
        },
        "usages": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/recipeObject" }
        },
        "actions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/recipeObject" }
        }
      }
    },
    "iconDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewBox",
        "geometry",
        "defaultSize",
        "allowedSizes",
        "opticalAlignment"
      ],
      "properties": {
        "viewBox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "geometry": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/iconGeometryPart" }
        },
        "defaultSize": { "$ref": "#/$defs/name" },
        "allowedSizes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        },
        "opticalAlignment": { "$ref": "#/$defs/name" },
        "pathFingerprint": { "type": "string", "minLength": 1 }
      }
    },
    "iconGeometryPart": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/name" }
      },
      "additionalProperties": { "$ref": "#/$defs/recipeValue" }
    },
    "recipeTokens": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/recipeObject" }
    },
    "componentDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anatomy",
        "slots",
        "variants",
        "sizes",
        "states",
        "semantics"
      ],
      "properties": {
        "anatomy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        },
        "slots": { "$ref": "#/$defs/recipeObject" },
        "variants": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/recipeObject" }
        },
        "sizes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/recipeObject" }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        },
        "semantics": { "$ref": "#/$defs/recipeObject" }
      }
    },
    "recipeObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/recipeValue" }
    },
    "recipeValue": {
      "oneOf": [
        { "$ref": "#/$defs/reference" },
        { "type": "string", "not": { "pattern": "^\\{" } },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/recipeValue" }
        },
        { "$ref": "#/$defs/recipeObject" }
      ]
    }
  }
}
