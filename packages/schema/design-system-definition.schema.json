{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansldes.dev/schema/design-system-definition.v1.json",
  "title": "AnslDes product design-system definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "themes",
    "foundations",
    "components"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/name" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "themes": { "$ref": "#/$defs/themes" },
    "foundations": { "$ref": "#/$defs/foundations" },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/componentDefinition" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "reference": {
      "type": "string",
      "pattern": "^\\{(?:color|spacing|radius|size|typography|motion|elevation|layer)\\.[a-z0-9][a-z0-9._-]*\\}$"
    },
    "themes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "default"],
      "properties": {
        "names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        },
        "default": { "$ref": "#/$defs/name" }
      }
    },
    "foundations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "spacing",
        "radius",
        "size",
        "typography",
        "motion",
        "elevation",
        "layer"
      ],
      "properties": {
        "color": { "$ref": "#/$defs/colorTokens" },
        "spacing": { "$ref": "#/$defs/spacingTokens" },
        "radius": { "$ref": "#/$defs/numericTokens" },
        "size": { "$ref": "#/$defs/numericTokens" },
        "typography": { "$ref": "#/$defs/typographyTokens" },
        "motion": { "$ref": "#/$defs/motionTokens" },
        "elevation": { "$ref": "#/$defs/recipeTokens" },
        "layer": { "$ref": "#/$defs/integerTokens" }
      }
    },
    "colorTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive", "semantic", "component", "asset"],
      "properties": {
        "primitive": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
          }
        },
        "semantic": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "$ref": "#/$defs/reference" }
          }
        },
        "component": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/reference" }
        },
        "asset": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
          }
        }
      }
    },
    "numericTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive", "semantic", "component"],
      "properties": {
        "primitive": { "$ref": "#/$defs/numberMap" },
        "semantic": { "$ref": "#/$defs/numericValueMap" },
        "component": { "$ref": "#/$defs/numericValueMap" }
      }
    },
    "spacingTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive", "semantic", "component"],
      "properties": {
        "primitive": { "$ref": "#/$defs/numberMap" },
        "semantic": { "$ref": "#/$defs/numericValueMap" },
        "component": { "$ref": "#/$defs/signedNumericValueMap" }
      }
    },
    "integerTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic", "component"],
      "properties": {
        "semantic": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer" }
        },
        "component": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      }
    },
    "nonNegativeNumberMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "numberMap": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "numericValueMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/reference" },
          { "type": "number", "minimum": 0 }
        ]
      }
    },
    "signedNumericValueMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [{ "$ref": "#/$defs/reference" }, { "type": "number" }]
      }
    },
    "referenceMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/reference" }
    },
    "typographyTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familyName", "weights", "tokens", "roles"],
      "properties": {
        "familyName": { "type": "string", "minLength": 1 },
        "weights": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fontFamily", "fontWeight"],
            "properties": {
              "fontFamily": { "type": "string", "minLength": 1 },
              "fontWeight": { "type": "integer", "minimum": 1, "maximum": 1000 }
            }
          }
        },
        "tokens": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fontSize",
              "lineHeight",
              "maxFontSizeMultiplier",
              "allowedWeights"
            ],
            "properties": {
              "fontSize": { "type": "number", "exclusiveMinimum": 0 },
              "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
              "maxFontSizeMultiplier": { "type": "number", "minimum": 1 },
              "allowedWeights": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/name" }
              },
              "category": { "$ref": "#/$defs/name" },
              "functionalTextAllowed": { "type": "boolean" }
            }
          }
        },
        "roles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["visualToken", "weight"],
            "properties": {
              "visualToken": { "$ref": "#/$defs/name" },
              "weight": { "$ref": "#/$defs/name" }
            }
          }
        }
      }
    },
    "motionTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durations", "easings", "transitions"],
      "properties": {
        "durations": { "$ref": "#/$defs/nonNegativeNumberMap" },
        "easings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          }
        },
        "transitions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/recipeObject" }
        }
      }
    },
    "recipeTokens": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/recipeObject" }
    },
    "componentDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anatomy",
        "slots",
        "variants",
        "sizes",
        "states",
        "semantics"
      ],
      "properties": {
        "anatomy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        },
        "slots": { "$ref": "#/$defs/recipeObject" },
        "variants": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/recipeObject" }
        },
        "sizes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/recipeObject" }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        },
        "semantics": { "$ref": "#/$defs/recipeObject" }
      }
    },
    "recipeObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/recipeValue" }
    },
    "recipeValue": {
      "oneOf": [
        { "$ref": "#/$defs/reference" },
        { "type": "string", "not": { "pattern": "^\\{" } },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/recipeValue" }
        },
        { "$ref": "#/$defs/recipeObject" }
      ]
    }
  }
}
