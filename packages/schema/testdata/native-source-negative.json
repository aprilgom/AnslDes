{
  "$schema": "../native-source-evidence.schema.json",
  "schemaVersion": 1,
  "evidenceKind": "native-source",
  "platform": "react-native",
  "surfaceId": "example-native-surface",
  "nativePolicyVersion": "1.0.0",
  "controls": [
    {
      "id": "primary-action",
      "owner": "example-native-owner",
      "interactive": true,
      "label": "",
      "roleOrTrait": "",
      "stateAnnouncement": false,
      "readingOrder": 1,
      "focusOrder": 2
    },
    {
      "id": "secondary-action",
      "owner": "example-native-owner",
      "interactive": true,
      "label": "Secondary",
      "roleOrTrait": "button",
      "stateAnnouncement": true,
      "readingOrder": 2,
      "focusOrder": 1
    }
  ],
  "lists": [
    {
      "id": "results-list",
      "owner": "example-list-owner",
      "longList": true,
      "virtualized": false,
      "stableKey": false
    }
  ],
  "renderPaths": [
    {
      "id": "result-row",
      "owner": "example-list-owner",
      "unnecessaryRerender": true,
      "unstableCallback": true,
      "unstableKey": true,
      "memoizationRequired": true,
      "memoized": false
    }
  ],
  "images": [
    {
      "id": "result-thumbnail",
      "owner": "example-image-owner",
      "thumbnail": true,
      "displayPixels": 10000,
      "decodedPixels": 1000000,
      "cached": false,
      "repeatedLoad": true
    }
  ],
  "dependencies": [
    {
      "id": "unused-module",
      "owner": "example-build-owner",
      "used": false,
      "contributionBytes": 4096
    }
  ],
  "appearance": [
    {
      "id": "surface-material",
      "owner": "example-theme-owner",
      "rawColor": true,
      "semanticSystemRole": false,
      "handRolledMaterial": true
    }
  ],
  "patterns": [
    {
      "id": "hidden-justified-content",
      "owner": "example-native-owner",
      "textAlignment": "justify",
      "hiddenAtRest": true,
      "revealFallbackVisible": false,
      "rawAnimation": true,
      "transitionId": null
    }
  ],
  "adaptivity": {
    "owner": "example-layout-owner",
    "usesSizeOrWindowClass": false,
    "simplePhoneScaleOnExpanded": true,
    "supportsPortrait": true,
    "supportsLandscape": false,
    "supportsSplitView": false,
    "supportsMultiWindow": false,
    "supportsFoldPosture": false,
    "compactNavigation": "stack",
    "expandedNavigation": "none"
  },
  "navigation": {
    "owner": "example-navigation-owner",
    "iosNavigationStackOrSheet": false,
    "iosEdgeSwipeBack": false,
    "androidPredictiveBack": false
  }
}
