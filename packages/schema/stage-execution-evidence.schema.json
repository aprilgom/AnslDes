{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansldes.dev/schema/stage-execution-evidence.schema.json",
  "title": "deslint stage execution evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stageId",
    "owner",
    "platform",
    "command",
    "status",
    "exitCode",
    "stdout",
    "stderr",
    "dependencySha256",
    "observedDependencySha256"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "stageId": { "$ref": "#/$defs/name" },
    "owner": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": { "enum": ["pass", "fail"] },
    "exitCode": { "type": "integer", "minimum": 0 },
    "stdout": { "type": "string" },
    "stderr": { "type": "string" },
    "dependencySha256": { "$ref": "#/$defs/sha256" },
    "observedDependencySha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pass" } } },
      "then": { "properties": { "exitCode": { "const": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "fail" } } },
      "then": {
        "properties": { "exitCode": { "type": "integer", "minimum": 1 } }
      }
    }
  ],
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
