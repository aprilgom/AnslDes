{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansldes.dev/schema/motion-evidence.v1.json",
  "title": "AnslDes motion and reduced-motion evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceKind",
    "platform",
    "profileId",
    "surfaceId",
    "preference",
    "capturePath",
    "preferenceResolvedBeforeEffects",
    "effectsReplayedAfterResolution",
    "nodes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "evidenceKind": {
      "enum": [
        "web-source",
        "web-rendered",
        "native-source",
        "design-document-source",
        "design-document-computed",
        "simulator",
        "emulator",
        "physical-device"
      ]
    },
    "platform": {
      "enum": ["web", "react-native", "design-document", "ios", "android"]
    },
    "profileId": { "$ref": "#/$defs/name" },
    "surfaceId": { "$ref": "#/$defs/name" },
    "preference": { "enum": ["no-preference", "reduce"] },
    "capturePath": { "type": "string", "minLength": 1 },
    "preferenceResolvedBeforeEffects": { "type": "boolean" },
    "effectsReplayedAfterResolution": { "type": "boolean" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "purpose",
        "motionKind",
        "durationMs",
        "easing",
        "easingBehavior",
        "animatedProperties",
        "perpetual",
        "userControlled",
        "changingDataSource",
        "accessibleLabel",
        "editableInput",
        "hoverPurpose",
        "reducedMotionFallbackApplied",
        "reducedStateUnderstandable",
        "nextActionUnderstandable"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "owner": { "$ref": "#/$defs/name" },
        "transitionId": { "$ref": "#/$defs/name" },
        "purpose": {
          "enum": [
            "state-change",
            "feedback",
            "loading",
            "reveal",
            "decorative"
          ]
        },
        "motionKind": {
          "enum": [
            "state-change",
            "feedback",
            "loading",
            "reveal",
            "status-pulse",
            "fake-caret",
            "marquee",
            "layout-transition",
            "image-hover-transform"
          ]
        },
        "durationMs": { "type": "number", "minimum": 0 },
        "easing": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "easingBehavior": {
          "enum": ["standard", "bounce", "elastic", "overshoot"]
        },
        "animatedProperties": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "opacity",
              "transform",
              "width",
              "height",
              "padding",
              "margin",
              "scroll-offset"
            ]
          }
        },
        "perpetual": { "type": "boolean" },
        "userControlled": { "type": "boolean" },
        "changingDataSource": { "type": "boolean" },
        "accessibleLabel": { "type": "string" },
        "editableInput": { "type": "boolean" },
        "hoverPurpose": { "enum": ["none", "functional", "decorative"] },
        "reducedMotionFallbackApplied": { "type": "boolean" },
        "reducedStateUnderstandable": { "type": "boolean" },
        "nextActionUnderstandable": { "type": "boolean" }
      }
    }
  }
}
