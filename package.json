{
  "name": "ansldes-workspace",
  "private": true,
  "version": "1.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:react-native",
    "build:core": "tsc -p packages/core/tsconfig.json",
    "build:react-native": "tsc -p packages/react-native/tsconfig.json",
    "check": "npm run check:biome && npm run check:boundary && npm run check:anti-slop-registry && npm run check:anti-slop-contract && npm run test:schema && npm run test:compiler && npm run build && npm run test:core && npm run test:react-native && npm run check:deslint && npm run test:release && npm run release:check",
    "check:anti-slop-contract": "node scripts/check-anti-slop-contract.mjs",
    "check:anti-slop-registry": "node scripts/anti-slop-registry.mjs --check",
    "check:biome": "biome ci .",
    "check:boundary": "node scripts/check-product-boundary.mjs",
    "check:deslint": "npm run generate:models:check && tsc -p tsconfig.models.json && npm run fix:deslint:check && npm run lint:deslint && cd deslint && go test ./... && go test -race ./... && go vet ./...",
    "fix:deslint": "cd deslint && go fix ./...",
    "fix:deslint:check": "cd deslint && go fix -diff ./...",
    "fix:biome": "biome check --write .",
    "format": "biome format --write .",
    "generate:models": "node scripts/generate-contract-models.mjs",
    "generate:models:check": "node scripts/generate-contract-models.mjs --check",
    "generate:anti-slop-registry": "node scripts/anti-slop-registry.mjs --write",
    "lint": "biome lint .",
    "lint:deslint": "cd deslint && go tool -modfile=golangci-lint.mod golangci-lint run",
    "prepare": "husky",
    "release:manifest": "node scripts/release-manifest.mjs --write",
    "release:check": "node scripts/release-manifest.mjs --check",
    "test:release": "node --test scripts/release-manifest.test.mjs",
    "test:core": "node --test packages/core/test/runtime.test.mjs",
    "test:react-native": "node --test packages/react-native/test/*.test.mjs",
    "test:compiler": "node --test packages/compiler/src/index.test.mjs",
    "test:schema": "node --test scripts/design-system-schema.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/react": "19.2.2",
    "ajv": "8.20.0",
    "husky": "9.1.7",
    "react": "19.2.3",
    "typescript": "6.0.3"
  }
}
